{
  "global": {
    "theme": "dark",
    "compactMode": true,
    "disableAnimations": true,
    "font": "Hack Nerd Font, monospace",
    "fontSize": "12px",
    "aerospacePath": "/opt/homebrew/bin/aerospace",
    "windowManager": "aerospace",
    "shell": "bash"
  },
  "themes": {
    "lightTheme": "RosePineDawn",
    "darkTheme": "RosePineMoon",
    "colorMain": "#3b0b18",
    "colorMainAlt": "#5d1024",
    "colorMinor": "#86182f",
    "colorAccent": "#ff4d67",
    "colorRed": "#ff4057",
    "colorGreen": "#d7827e",
    "colorYellow": "#f6c177",
    "colorOrange": "#ea9a97",
    "colorBlue": "#c45b78",
    "colorMagenta": "#e84a68",
    "colorCyan": "#f0a4af",
    "colorBlack": "#080608",
    "colorWhite": "#fff1f3",
    "colorForeground": "#f6e7ea",
    "colorBackground": "#16070d"
  },
  "process": {
    "centered": false,
    "showCurrentSpaceMode": true
  },
  "spacesDisplay": {
    "hideCreateSpaceButton": true,
    "hideEmptySpaces": true,
    "showOptionsOnHover": false
  },
  "widgets": {
    "processWidget": false,
    "weatherWidget": false,
    "netstatsWidget": false,
    "cpuWidget": false,
    "gpuWidget": false,
    "memoryWidget": false,
    "batteryWidget": true,
    "wifiWidget": true,
    "vpnWidget": false,
    "soundWidget": true,
    "micWidget": false,
    "dateWidget": true,
    "timeWidget": true,
    "spotifyWidget": false,
    "musicWidget": false,
    "browserTrackWidget": false
  },
  "customStyles": {
    "styles": ":root { --bar-height: 32px; } .simple-bar { background-color: color-mix(in srgb, var(--background) 60%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }"
  }
}
