{
  "global": {
    "theme": "dark",
    "compactMode": true,
    "disableAnimations": true,
    "font": "Hack Nerd Font, monospace",
    "fontSize": "12px",
    "aerospacePath": "/opt/homebrew/bin/aerospace",
    "windowManager": "aerospace",
    "shell": "bash"
  },
  "themes": {
    "lightTheme": "RosePineDawn",
    "darkTheme": "RosePineMoon"
  },
  "process": {
    "centered": false,
    "showCurrentSpaceMode": true
  },
  "spacesDisplay": {
    "hideCreateSpaceButton": true,
    "hideEmptySpaces": true,
    "showOptionsOnHover": false
  },
  "widgets": {
    "processWidget": false,
    "weatherWidget": false,
    "netstatsWidget": false,
    "cpuWidget": false,
    "gpuWidget": false,
    "memoryWidget": false,
    "batteryWidget": true,
    "wifiWidget": true,
    "vpnWidget": false,
    "soundWidget": true,
    "micWidget": false,
    "dateWidget": true,
    "timeWidget": true,
    "spotifyWidget": false,
    "musicWidget": false,
    "browserTrackWidget": false
  },
  "customStyles": {
    "styles": ":root { --bar-height: 32px; } .simple-bar { background-color: color-mix(in srgb, var(--background) 80%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }"
  }
}
