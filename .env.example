# Copy to .env and fill in. .env is not tracked, so machine-specific hosts and
# accounts stay out of the repository.
#
# The macOS account is NOT here - it is part of each host definition in
# flake.nix, so the system builds with pure evaluation.

# SSH target for the persistent remote Herdr session that `rcc` attaches to.
HERDR_REMOTE=host.example.com

# GlobalProtect portal and account for vpn.sh (work host only).
VPN_PORTAL=vpn.example.com
VPN_USER=your-account
