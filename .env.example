# Copy to .env and fill in. .env is not tracked, so machine-specific names and
# hosts stay out of the repository.

# macOS account the flake builds for. rebuild.sh exports this so flake.nix can
# read it; without it the flake falls back to its default account.
DOTFILES_USER=your-account

# Set to "true" on a work Mac to install work-only packages (Teams, Webex).
# Leave "false" on a personal machine.
DOTFILES_WORK_MACHINE=false

# SSH target for the persistent remote Herdr session that `rcc` attaches to.
HERDR_REMOTE=host.example.com

# GlobalProtect portal and account for vpn.sh.
VPN_PORTAL=vpn.example.com
VPN_USER=your-account
